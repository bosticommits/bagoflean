local fs = require("@lune/fs")
local roblox = require("@lune/roblox")

local H = require("./harness")
local Founder = H.require("Founder")
local Config = H.require("Config")
local Badges = H.require("Badges")
local LotLook = H.require("Models/LotLook")
local LotModels = H.require("Models/LotModels")
local test, expect, equal = H.test, H.expect, H.equal

local BEFORE = Founder.CutOff - 86400

test("isFounder: needs a table save with the tutorial done, created before the cut-off", function()
	equal(Founder.isFounder(nil, BEFORE), false, "no save")
	equal(Founder.isFounder("x", BEFORE), false, "not a table")
	equal(Founder.isFounder({ tutorialDone = false }, BEFORE), false, "tutorial not done")
	equal(Founder.isFounder({}, BEFORE), false, "field missing")
	equal(Founder.isFounder({ tutorialDone = true }, 0), false, "no creation time")
	equal(Founder.isFounder({ tutorialDone = true }, Founder.CutOff), false, "at the cut-off")
	equal(Founder.isFounder({ tutorialDone = true }, Founder.CutOff + 5), false, "after the cut-off")
	equal(Founder.isFounder({ tutorialDone = true }, BEFORE), true, "founder")
end)

test("cut-off is 2026-11-19 00:00 UTC", function()
	equal(Founder.CutOff, 1795046400)
	equal(os.date("!%Y-%m-%d %H:%M", Founder.CutOff), "2026-11-19 00:00")
end)

test("settle: grants once, and the first verdict sticks", function()
	local data = { founder = false, founderChecked = false }
	equal(Founder.settle(data, true), true, "first call grants")
	equal(data.founder, true)
	equal(data.founderChecked, true)
	equal(Founder.settle(data, true), false, "second call grants nothing")
	equal(data.founder, true, "still a founder")

	local fresh = { founder = false, founderChecked = false }
	equal(Founder.settle(fresh, false), false, "not a founder")
	equal(fresh.founderChecked, true, "but checked")
	equal(Founder.settle(fresh, true), false, "checked once only")
	equal(fresh.founder, false, "stays a non-founder")
end)

test("the switch is off and the Founding Tester badge id is set", function()
	equal(Config.LaunchWipe, false, "LaunchWipe must stay false until launch day")
	local badge = Badges.List.FoundingTester
	expect(badge ~= nil, "FoundingTester badge defined")
	equal(badge.id, 950686223417379, "Creator Hub badge id")
	equal(badge.name, "Founding Tester")
end)

test("wipe wiring: v1 and v2 names kept, v1 only read, no schema bump, Main spawns the check", function()
	local data = fs.readFile("src/server/DataService.luau")
	expect(string.find(data, '"PlayerData_v1"', 1, true), "DataService keeps PlayerData_v1")
	expect(string.find(data, '"PlayerData_v2"', 1, true), "DataService has PlayerData_v2")
	expect(string.find(data, "CURRENT_VERSION = 12", 1, true), "no schema bump (v2 profiles start fresh at 12)")
	expect(string.find(data, "\tfounder = false,\n\tfounderChecked = false,", 1, true), "TEMPLATE founder fields")
	expect(string.find(data, "oldStore:GetAsync", 1, true), "old store read with GetAsync")
	expect(string.find(data, "ProfileStore.IsClosing", 1, true), "shutdown read is not taken as 'no save'")
	expect(not string.find(data, "oldStore:StartSessionAsync", 1, true), "old store never takes a session")
	expect(not string.find(data, "oldStore:RemoveAsync", 1, true), "old store never deleted")
	expect(not string.find(data, "oldStore.Mock:StartSessionAsync", 1, true), "old store never takes a session (mock)")
	local board = fs.readFile("src/server/LeaderboardService.luau")
	expect(string.find(board, "TopStudiosFame_v1", 1, true), "board keeps v1 name")
	expect(string.find(board, "TopStudiosFame_v2", 1, true), "board has v2 name")
	local main = fs.readFile("src/server/Main.server.luau")
	expect(string.find(main, "task.spawn(FounderService.check, player)", 1, true), "Main spawns the check")
end)

test("FounderService: one live re-get, FounderCheck kill switch, badge every join", function()
	local src = fs.readFile("src/server/FounderService.luau")
	expect(string.find(src, 'LiveConfig.switchedOff("FounderCheck")', 1, true), "kill switch")
	expect(string.find(src, "Config.LaunchWipe", 1, true), "only checks after the flip")
	expect(string.find(src, 'BadgeAwards.award(player, "FoundingTester")', 1, true), "badge")
	expect(string.find(src, '"FoundingTester"', 1, true), "tag attribute")
	expect(string.find(src, '"FounderNew"', 1, true), "first-grant attribute")
	expect(not string.find(src, "StartSessionAsync", 1, true), "never opens a session on the old store")
end)

test("the star: LotService has a Founder section, mesh only, no part fallback", function()
	local lot = fs.readFile("src/server/LotService.luau")
	expect(string.find(lot, '"Founder"', 1, true), "Founder section")
	local look = fs.readFile("src/shared/Models/LotLook.luau")
	expect(string.find(look, '"FounderStar"', 1, true), "uses the FounderStar mesh")
	expect(string.find(look, "Founding Tester", 1, true), "plaque text")
	-- Outside Roblox there is no LotMeshes folder: nothing at all is drawn.
	local folder = roblox.Instance.new("Folder")
	local star = LotLook.founderStar(folder, roblox.CFrame.new(), "Casey")
	equal(star, nil, "no mesh, no star")
	equal(#folder:GetChildren(), 0, "and nothing else added")
	local pos = LotModels.Layout.founderStar
	equal(pos.X, 0)
	equal(pos.Z, -23.5, "between the gate and the claim pad")
end)

test("client: gold [Founder] tag and one toast", function()
	local src = fs.readFile("src/client/Main.client.luau")
	expect(string.find(src, '[Founder]', 1, true), "chat tag")
	expect(string.find(src, '"FoundingTester"', 1, true), "reads the attribute")
	expect(string.find(src, "Thanks for testing! Your Founding Tester star is on your lot.", 1, true), "toast text")
	expect(string.find(src, '"FounderNew"', 1, true), "toast only on the first grant")
	expect(string.find(src, "Founder.toastReady", 1, true), "toast waits for toastReady")
	expect(string.find(src, '"IntroOpen"', 1, true), "and watches the intro overlay")
	expect(string.find(src, '"LotIndex"', 1, true), "and the claimed lot")
	local tutorial = fs.readFile("src/client/Tutorial.luau")
	expect(string.find(tutorial, 'gui:SetAttribute("IntroOpen"', 1, true), "Tutorial publishes the intro overlay")
end)

test("toastReady: only after the grant, a claimed lot and a closed intro, and only once", function()
	local ready = { granted = true, claimed = true, introOpen = false, shown = false }
	equal(Founder.toastReady(ready), true, "all clear")
	equal(Founder.toastReady({ granted = false, claimed = true, introOpen = false, shown = false }), false, "not granted this join")
	equal(Founder.toastReady({ granted = true, claimed = false, introOpen = false, shown = false }), false, "lot not claimed yet")
	equal(Founder.toastReady({ granted = true, claimed = true, introOpen = true, shown = false }), false, "intro still covering the screen")
	equal(Founder.toastReady({ granted = true, claimed = true, introOpen = false, shown = true }), false, "already shown")
end)

test("the v1 read is never cancelled: a slow read finishes in the background", function()
	local data = fs.readFile("src/server/DataService.luau")
	expect(not string.find(data, "task.cancel", 1, true), "no task.cancel on the old-save read")
	local svc = fs.readFile("src/server/FounderService.luau")
	expect(not string.find(svc, "FounderBadgeId", 1, true), "no stale badge config reference")
	expect(string.find(svc, "Badges.List.FoundingTester.id", 1, true), "comment points at the badge id")
end)
